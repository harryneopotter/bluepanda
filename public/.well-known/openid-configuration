{
  "issuer": "https://auth.bluepanda.in",
  "authorization_endpoint": "https://auth.bluepanda.in/authorize",
  "token_endpoint": "https://auth.bluepanda.in/token",
  "jwks_uri": "https://auth.bluepanda.in/.well-known/jwks.json",
  "response_types_supported": [
    "code",
    "token",
    "id_token"
  ],
  "subject_types_supported": [
    "public"
  ],
  "id_token_signing_alg_values_supported": [
    "RS256"
  ],
  "scopes_supported": [
    "openid",
    "profile",
    "email",
    "agent:read",
    "agent:write"
  ],
  "token_endpoint_auth_methods_supported": [
    "client_secret_basic",
    "private_key_jwt"
  ],
  "claims_supported": [
    "sub",
    "iss",
    "aud",
    "exp",
    "iat"
  ]
}
